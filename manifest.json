{
    "manifest_version":3,
    "name":"extension_name",
    "version":"1.0",
    "description":"Chrome Extension Description",
    "action":{
        "default_popup":"index.html"
    },
    "permissions":[
        "storage"
    ],
    "content_scripts":[
        {
            "matches":["<all_urls>"],
            "js":["js/content.js"]
        }
    ],
    "background":{
        "service_worker": "js/background.js"
    }
}